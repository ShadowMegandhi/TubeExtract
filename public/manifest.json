{
  "manifest_version": 3,
  "name": "ExtractTube - YouTube to MP4/MP3 & Media Converter",
  "short_name": "ExtractTube",
  "version": "0.2.0",
  "description": "Save YouTube links as MP4 or MP3, and convert video and audio files right in your browser. Not affiliated with YouTube.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "ExtractTube",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
