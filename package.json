{
  "name": "tubeextract",
  "version": "0.3.2",
  "private": true,
  "description": "Chrome extension: save YouTube links as MP4/MP3 and convert media files in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build.mjs --dev --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "zip": "node scripts/zip.mjs",
    "e2e": "playwright test",
    "bump": "node scripts/bump.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "preact": "^10.29.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
